{
  "id": "typescript",
  "name": "TypeScript",
  "extensions": [
    ".ts",
    ".tsx",
    ".mts",
    ".cts"
  ],
  "states": {
    "root": [
      {
        "token": "comment",
        "regex": "//.*"
      },
      {
        "token": "comment",
        "regex": "/\\*",
        "next": "comment"
      },
      {
        "token": "string",
        "regex": "`",
        "next": "template"
      },
      {
        "token": "string",
        "regex": "\"(?:[^\"\\\\]|\\\\.)*\"?|'(?:[^'\\\\]|\\\\.)*'?"
      },
      {
        "token": "regexp",
        "regex": "(?<=(?:^|[=(,:;!&|?{}\\[]|return|typeof)\\s*)/(?![*/])(?:[^/\\\\\\[\\n]|\\\\.|\\[(?:[^\\]\\\\\\n]|\\\\.)*\\])+/[dgimsuyv]*"
      },
      {
        "token": "meta",
        "regex": "@[A-Za-z_$][\\w$.]*"
      },
      {
        "token": "number",
        "regex": "\\b(?:0[xX][\\da-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[nfFlLuU]?)\\b|\\.\\d+\\b"
      },
      {
        "token": "keyword",
        "regex": "\\b(?:break|case|catch|class|const|continue|debugger|default|delete|do|else|export|extends|finally|for|from|function|if|import|in|instanceof|let|new|of|return|super|switch|this|throw|try|typeof|var|void|while|with|yield|async|await|static|get|set|as|interface|type|enum|implements|namespace|module|declare|abstract|private|protected|public|readonly|keyof|infer|is|satisfies|override|unique)\\b"
      },
      {
        "token": "constant",
        "regex": "\\b(?:true|false|null|undefined|NaN|Infinity)\\b"
      },
      {
        "token": "type",
        "regex": "\\b(?:string|number|boolean|any|unknown|never|object|symbol|bigint|void)\\b"
      },
      {
        "token": "variable",
        "regex": "\\b(?:this|globalThis|window|document|console)\\b"
      },
      {
        "token": "type",
        "regex": "\\b[A-Z][a-z0-9]\\w*\\b"
      },
      {
        "token": "function",
        "regex": "[A-Za-z_$][\\w$]*(?=\\s*\\()"
      },
      {
        "token": "property",
        "regex": "(?<=\\.)[A-Za-z_$][\\w$]*"
      },
      {
        "token": "text",
        "regex": "[A-Za-z_$][\\w$]*"
      },
      {
        "token": "tag",
        "regex": "</?[A-Za-z][\\w.-]*|/?>"
      },
      {
        "token": "operator",
        "regex": "[-+*/%=<>!&|^~?:]+"
      },
      {
        "token": "punctuation",
        "regex": "[{}()\\[\\];,.]"
      }
    ],
    "comment": [
      {
        "token": "comment",
        "regex": "\\*/",
        "next": "@pop"
      },
      {
        "token": "comment",
        "regex": "[^*]+|\\*"
      }
    ],
    "template": [
      {
        "token": "escape",
        "regex": "\\\\."
      },
      {
        "token": "punctuation",
        "regex": "\\$\\{",
        "next": "templateExpr"
      },
      {
        "token": "string",
        "regex": "`",
        "next": "@pop"
      },
      {
        "token": "string",
        "regex": "[^\\`\\\\$]+|\\$"
      }
    ],
    "templateExpr": [
      {
        "token": "punctuation",
        "regex": "\\}",
        "next": "@pop"
      },
      {
        "token": "",
        "regex": "",
        "include": "root"
      }
    ]
  }
}
