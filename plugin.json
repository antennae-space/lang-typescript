{
  "$schema": "https://raw.githubusercontent.com/antennae-space/plugin-sdk/v1.6.0/plugin.schema.json",
  "id": "lang-typescript",
  "name": "JavaScript and TypeScript",
  "version": "1.0.0",
  "apiVersion": 1,
  "ide": ">=1.24.0 <2",
  "assets": "https://github.com/antennae-space/lang-typescript/releases/download/v{version}/lang-typescript-{arch}.tar.gz",
  "permissions": [
    "program:typescript-language-server",
    "path:NODE",
    "path:NODE_MODULES"
  ],
  "contributes": {
    "languages": [
      {
        "id": "typescript",
        "name": "TypeScript",
        "extensions": [
          ".ts",
          ".tsx",
          ".mts",
          ".cts"
        ],
        "markers": [
          "tsconfig.json",
          "package.json"
        ],
        "grammar": "grammars/typescript.json",
        "languageIds": {
          ".tsx": "typescriptreact"
        },
        "servers": [
          {
            "argv": [
              "typescript-language-server",
              "--stdio"
            ],
            "paths": [
              {
                "name": "NODE",
                "candidates": [
                  "@node/../.."
                ]
              },
              {
                "name": "NODE_MODULES",
                "candidates": [
                  "@typescript-language-server/../../.."
                ]
              }
            ],
            "pathDirs": [
              "NODE/bin"
            ]
          }
        ],
        "tests": {
          ".ts": "{name}.spec.ts",
          ".tsx": "{name}.spec.tsx"
        }
      },
      {
        "id": "javascript",
        "name": "JavaScript",
        "extensions": [
          ".js",
          ".jsx",
          ".mjs",
          ".cjs"
        ],
        "markers": [
          "package.json",
          "jsconfig.json"
        ],
        "grammar": "grammars/javascript.json",
        "languageIds": {
          ".jsx": "javascriptreact"
        },
        "servers": [
          {
            "argv": [
              "typescript-language-server",
              "--stdio"
            ],
            "paths": [
              {
                "name": "NODE",
                "candidates": [
                  "@node/../.."
                ]
              },
              {
                "name": "NODE_MODULES",
                "candidates": [
                  "@typescript-language-server/../../.."
                ]
              }
            ],
            "pathDirs": [
              "NODE/bin"
            ]
          }
        ],
        "tests": {
          ".js": "{name}.spec.js",
          ".jsx": "{name}.spec.jsx"
        }
      }
    ]
  }
}
